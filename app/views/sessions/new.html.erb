<section class="card">
  <h1>Sign in</h1>
  <%= form_with url: session_path, method: :post, local: true do |form| %>
    <div class="field">
      <%= form.label :email %>
      <%= form.email_field :email, required: true %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true %>
    </div>
    <%= form.submit "Log in", class: "btn btn-primary btn-square" %>
  <% end %>
</section>
